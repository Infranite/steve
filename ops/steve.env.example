# ~/.steve/steve.env — read by ops/run.sh. Secrets live in ~/.steve/secrets, referenced by *_FILE.
# Listen addresses, comma-separated (default 127.0.0.1). Add the address a reverse proxy on another machine reaches,
# e.g. 127.0.0.1,100.64.0.2 for a tailnet IP. 0.0.0.0 / :: is refused unless STEVE_ALLOW_ANY_HOST=1.
STEVE_HOST=127.0.0.1
STEVE_PORT=8440
# Optional: a URL reachable by your integrations; omit for local-only use.
# STEVE_PUBLIC_URL=https://steve.example.test
STEVE_OIDC_ISSUER=https://auth.example.test/application/o/steve/
STEVE_OIDC_CLIENT_ID=steve-web
STEVE_OIDC_CLIENT_SECRET_FILE=$HOME/.steve/secrets/oidc_client_secret
# the web build the Hub serves: a symlink that ops/release.sh switches for web-only releases (no Hub restart)
STEVE_WEB_DIR=$HOME/.steve/web/current
# Task workspaces (optional, defaults shown): below the floor no new worktree is made; below low, idle items'
# build caches are given back too. STEVE_GIT pins the git Steve runs (default: git on PATH).
# STEVE_DISK_FLOOR_GB=10
# STEVE_DISK_LOW_GB=40
# STEVE_WORKTREE_IDLE_HOURS=24
# STEVE_GIT=/usr/bin/git
# The Hub's own Node runs the agents' harnesses (the Hub runs none itself). Unset = service: a process of
# its own, so a Hub restart or upgrade leaves its turns running. local keeps it in the Hub's process. With
# off, sessions already on the Node only queue (parked) and new sessions are refused until it is on again.
# STEVE_NO_RESUME copies (a copied database for testing) keep it off; service and local are refused there.
# STEVE_NODE_MODE=service
# New sessions use separate principal harness state by default; existing sessions keep theirs.
# Codex login is NOT copied: authenticate in the recorded Node state directory before continuing
# new tasks (docs/deployment.md#harness-setup). Explicit off uses shared state for new sessions only.
# STEVE_PRINCIPAL_STATE=on
# Default on, configured in each Node's environment. A moved build may start cold; explicit off
# keeps original toolchain locations. No cache is assigned without a known principal.
# STEVE_TOOLCHAINS=on
# Remote pairing/listener defaults to 1; explicit 0 disables it. STEVE_NO_RESUME=1 always disables it.
# This does not register a device, grant roots/credentials, or assign any work.
# STEVE_NODE_LISTEN=1
# STEVE_NODE_BIND has NO default. Set only to a paired Node ID intentionally selected for new sessions.
# Bounded asynchronous disk observations default on in each Node; explicit off stops new records.
# They grant no cleanup permission. Budget and retention settings: docs/deployment.md#node-disk-observations.
# STEVE_DISK_OBSERVE=on
