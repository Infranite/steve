# ~/.steve/steve.env — read by ops/run.sh. Secrets live in ~/.steve/secrets, referenced by *_FILE.
STEVE_HOST=127.0.0.1
STEVE_PORT=8440
# Optional: a URL reachable by your integrations; omit for local-only use.
# STEVE_PUBLIC_URL=https://steve.example.test
STEVE_OIDC_ISSUER=https://auth.example.test/application/o/steve/
STEVE_OIDC_CLIENT_ID=steve-web
STEVE_OIDC_CLIENT_SECRET_FILE=$HOME/.steve/secrets/oidc_client_secret
# the web build the Hub serves: a symlink that ops/release.sh switches for web-only releases (no Hub restart)
STEVE_WEB_DIR=$HOME/.steve/web/current
# Task workspaces (optional, defaults shown): below the floor no new worktree is made; below low, idle items'
# build caches are given back too. STEVE_GIT pins the git Steve runs (default: git on PATH).
# STEVE_DISK_FLOOR_GB=10
# STEVE_DISK_LOW_GB=40
# STEVE_WORKTREE_IDLE_HOURS=24
# STEVE_GIT=/usr/bin/git
