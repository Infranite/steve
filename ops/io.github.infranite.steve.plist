<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.github.infranite.steve</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__HOME__/.steve/current/ops/run.sh</string></array>
  <key>EnvironmentVariables</key><dict><key>STEVE_WEB_DIR</key><string>__HOME__/.steve/web/current</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>__HOME__/.steve/logs/hub.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.steve/logs/hub.log</string>
</dict></plist>
