  "mcp_clients": [
    {
      "id": "generic",
      "language": "json",
      "wrap": false,
      "template": {
        "mcpServers": {
          "{{name}}": {
            "type": "http",
            "url": "{{url}}",
            "headers": {
              "Authorization": "{{bearer}}"
            }
          }
        }
      }
    },
    {
      "id": "claudeDesktop",
      "language": "json",
      "file": "claude_desktop_config.json",
      "wrap": false,
      "template": {
        "mcpServers": {
          "{{name}}": {
            "command": "npx",
            "args": [
              "-y",
              "mcp-remote",
              "{{url}}",
              "--header",
              "Authorization:${STEVE_AUTH}"
            ],
            "env": {
              "STEVE_AUTH": "{{bearer}}"
            }
          }
        }
      }
    },
    {
      "id": "cursor",
      "language": "json",
      "file": "mcp.json",
      "wrap": false,
      "template": {
        "mcpServers": {
          "{{name}}": {
            "url": "{{url}}",
            "headers": {
              "Authorization": "{{bearer}}"
            }
          }
        }
      }
    },
    {
      "id": "claudeCode",
      "language": "bash",
      "wrap": true,
      "command_template": "claude mcp add --transport http {{name}} {{url}} --header {{auth_header}}"
    }
  ]
}
