(deny file-read* file-write*
  (subpath "/fixture/steve/signing")
  (subpath "/fixture/steve/secrets")
  (subpath "/fixture/steve/backups")
  (subpath "/fixture/steve/updates")
  (regex #"^/fixture/steve/steve\.env")
  (regex #"^/fixture/steve/steve\.db")
  (regex #"^/fixture/steve/data/steve\.sqlite3")
  (subpath "/fixture/steve/data/files")
  (subpath "/fixture/steve/data/mail")
  (subpath "/fixture/steve/data/nodes")
  (regex #"^/fixture/steve/data/node/node\.sqlite3")
  (subpath "/fixture/steve/data/node/secrets")
  (subpath "/fixture/steve/data/node/push")
  (subpath "/fixture/steve/data/node/blobs")
  (literal "/fixture/steve/node/identity.key")
  (subpath "/fixture/steve/node/identity.key")
  (literal "/fixture/steve/node/node.json")
  (subpath "/fixture/steve/node/node.json")
  (literal "/fixture/steve/policy.json")
  (subpath "/fixture/steve/policy.json")
  (literal "/fixture/steve/roots.json")
  (subpath "/fixture/steve/roots.json")
  (literal "/fixture/steve/harness.json")
  (subpath "/fixture/steve/harness.json")
  (regex #"^/fixture/node/node\.sqlite3")
  (subpath "/fixture/node/secrets")
  (subpath "/fixture/node/push")
  (subpath "/fixture/node/blobs")
  (subpath "/fixture/node/state")
  (subpath "/fixture/node/cache"))
(deny file-write*
  (subpath "/fixture/steve/releases")
  (literal "/fixture/steve/current")
  (subpath "/fixture/steve/current")
  (subpath "/fixture/steve/web")
  (subpath "/fixture/steve/bin")
  (subpath "/fixture/steve/build")
  (subpath "/fixture/steve/plugins"))
(deny file-write*
  (literal "/")
  (literal "/fixture")
  (literal "/fixture/node")
  (literal "/fixture/steve")
  (literal "/fixture/steve/data")
  (literal "/fixture/steve/data/node")
  (literal "/fixture/steve/node"))
