as_user feishu_user
channel feishu_app
decl feishu_app platform 1ms
decl feishu_user platform 1ms
event_source github_app
event_source github_pat
jobs 14
lifecycle feishu_app
lifecycle feishu_user
mail imap
media feishu_app
media feishu_user
profiles feishu_app
profiles feishu_user
provider feishu_app {"id":"feishu_app","system":"feishu_app","name":"飞书应用机器人","auth":"credential","caps":["msg.receive","msg.send","directory.read","events"],"device":false,"fields":[{"key":"app_id","label":"App ID","secret":false,"required":true,"type":"text","hint":"开发者后台 → 凭证与基础信息"},{"key":"app_secret","label":"App Secret","secret":true,"required":true,"type":"password"},{"key":"verification_token","label":"Verification Token","secret":true,"required":false,"type":"password","hint":"只有用 webhook 接收事件时需要；长连接不需要"},{"key":"encrypt_key","label":"Encrypt Key","secret":true,"required":false,"type":"password","hint":"只有用 webhook 接收事件时需要；长连接不需要"},{"key":"domain","label":"域名","secret":false,"required":true,"type":"select","default":"feishu","hint":"feishu = 飞书，lark = Lark"}]}
provider feishu_user {"id":"feishu_user","system":"feishu","name":"飞书 · 你本人","auth":"oauth","caps":["msg.receive","msg.send_as_user"],"device":false}
provider github_app managed
provider github_pat {"id":"github_pat","system":"github","name":"GitHub 个人令牌","auth":"credential","caps":["repo.read","repo.write","events"],"device":false,"fields":[{"key":"token","label":"令牌","secret":true,"required":true,"type":"password","hint":"GitHub 设置 → Developer settings → Fine-grained tokens：选好仓库，给 Contents、Pull requests、Issues 读写，Checks、Actions 读；要接收事件再给 Webhooks 读写"}]}
provider imap {"id":"imap","system":"mail","name":"其他邮箱（IMAP）","auth":"credential","caps":["mail.read","mail.draft","mail.send","events"],"device":false,"fields":[{"key":"address","label":"邮箱地址","secret":false,"required":true,"type":"text"},{"key":"username","label":"用户名","secret":false,"required":false,"type":"text","hint":"默认同邮箱地址"},{"key":"password","label":"应用专用密码","secret":true,"required":true,"type":"password"},{"key":"imap_host","label":"IMAP 服务器","secret":false,"required":true,"type":"text"},{"key":"imap_port","label":"IMAP 端口","secret":false,"required":true,"type":"number","default":"993"},{"key":"imap_security","label":"IMAP 加密","secret":false,"required":true,"type":"select","default":"tls","hint":"tls | starttls"},{"key":"smtp_host","label":"SMTP 服务器","secret":false,"required":true,"type":"text"},{"key":"smtp_port","label":"SMTP 端口","secret":false,"required":true,"type":"number","default":"465"},{"key":"smtp_security","label":"SMTP 加密","secret":false,"required":true,"type":"select","default":"tls","hint":"tls | starttls"}]}
root GET /auth/connect/callback
root POST /hooks/github
root POST /hooks/x
