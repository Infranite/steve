[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "install_hint": "@agentclientprotocol/claude-agent-acp",
    "npm_package": "@agentclientprotocol/claude-agent-acp",
    "cli_bin": "claude-agent-acp",
    "detect_bins": [
      "claude",
      "claude-code-acp"
    ],
    "args": [],
    "env": [],
    "command_var": "STEVE_ADAPTER_CLAUDE",
    "properties": {
      "native_approval": "ask_owner",
      "self_read_only": false,
      "nested_sandbox": true,
      "state": {
        "env": "CLAUDE_CONFIG_DIR",
        "default": ".claude",
        "import": [
          "settings.json"
        ],
        "context": [
          "CLAUDE.md",
          "skills/*",
          "agents",
          "commands",
          "output-styles"
        ],
        "login": {
          "files": [
            ".credentials.json"
          ],
          "renew": [
            ".storage-write.lock",
            ".credentials.json.tmp.*"
          ],
          "store_env": "CLAUDE_SECURESTORAGE_CONFIG_DIR",
          "settings": "settings.json",
          "entries": [
            "apiKeyHelper",
            "awsAuthRefresh",
            "awsCredentialExport",
            "forceLoginMethod",
            "forceLoginOrgUUID",
            "env.ANTHROPIC_*",
            "env.CLAUDE_CODE_USE_*",
            "env.AWS_*",
            "env.CLOUD_ML_REGION",
            "env.VERTEX_REGION_*"
          ]
        },
        "home_files": [
          ".claude.json"
        ]
      },
      "modes": {
        "plan": "plan",
        "ask": "default",
        "accept_edits": "acceptEdits",
        "auto": "auto",
        "full_access": "bypassPermissions"
      },
      "blind_set_mode": false,
      "native_execution": false,
      "permission_policy": "acp",
      "require_mcp_http": false,
      "mode_meta": {},
      "mode_args": {},
      "executable_env": "CLAUDE_CODE_EXECUTABLE",
      "session_meta": "claude_settings",
      "launch_extra": "none",
      "probe_initialize": true,
      "tools_off_meta": {
        "claudeCode": {
          "options": {
            "tools": []
          }
        }
      },
      "usage_input_includes_cache": false,
      "usage_prompt_cumulative": false,
      "usage_fallback": "claude_transcript",
      "fallback_models": [
        "claude-opus-5-5",
        "claude-sonnet-5-5",
        "claude-haiku-5-5"
      ],
      "fallback_efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "model_fallback": true,
      "fast_models": [
        "haiku"
      ],
      "skills": "skills",
      "resume_cli": "claude --resume {id}",
      "fork_cli": "claude --resume {id} --fork-session",
      "local_transcript": true,
      "outer_sandbox_args": []
    },
    "components": [
      {
        "id": "adapter",
        "name": "Claude Code",
        "package": "@agentclientprotocol/claude-agent-acp",
        "entry": "@agentclientprotocol/claude-agent-acp/dist/index.js",
        "node_min": [
          20,
          0,
          0
        ],
        "executable_env": null,
        "required": [],
        "minimum": null
      }
    ]
  },
